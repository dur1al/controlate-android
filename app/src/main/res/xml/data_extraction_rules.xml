<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: excluye datos operativos (PII) tanto del respaldo en la nube como de la
     transferencia entre dispositivos. allowBackup="false" no cubre la transferencia D2D. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="controlate_secure_prefs.xml" />
        <exclude domain="sharedpref" path="porteria_prefs.xml" />
        <exclude domain="database" path="porteria_db" />
        <exclude domain="database" path="porteria_db-shm" />
        <exclude domain="database" path="porteria_db-wal" />
        <exclude domain="file" path="reports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="controlate_secure_prefs.xml" />
        <exclude domain="sharedpref" path="porteria_prefs.xml" />
        <exclude domain="database" path="porteria_db" />
        <exclude domain="database" path="porteria_db-shm" />
        <exclude domain="database" path="porteria_db-wal" />
        <exclude domain="file" path="reports/" />
    </device-transfer>
</data-extraction-rules>
