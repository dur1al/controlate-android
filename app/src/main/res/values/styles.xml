<resources>
    <style name="Controlate" parent="Theme.Material3.Dark.NoActionBar" />
    <style name="Controlate.Text" parent="TextAppearance.Material3.BodyMedium" />

    <style name="Controlate.Text.Display">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Controlate.Text.Heading">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Controlate.Text.Section">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Controlate.Text.Body">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Controlate.Text.Caption">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Controlate.Title">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="Controlate.SectionLabel">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Controlate.HintText">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Controlate.OutlinedInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/text_hint</item>
        <item name="boxStrokeColor">@color/outline_soft</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Controlate.DropdownInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="hintTextColor">@color/text_hint</item>
        <item name="boxStrokeColor">@color/outline_soft</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="Controlate.Card.Primary" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_variant</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Controlate.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Controlate.Button.Pill" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Controlate.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/nunito</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="Controlate.Card.Action" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_variant</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Controlate.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/text_main</item>
        <item name="navigationIconTint">@color/text_main</item>
    </style>
</resources>
