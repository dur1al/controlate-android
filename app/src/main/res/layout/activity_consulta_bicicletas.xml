<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_bicicletero"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_main"
        app:title="@string/dashboard_bicicletero_title"
        app:titleTextAppearance="@style/Controlate.Toolbar.Title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBicicletas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/list_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />
</LinearLayout>
