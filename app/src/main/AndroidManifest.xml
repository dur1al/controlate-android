<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Controlate">

        <activity
            android:name=".porteria.ui.login.LoginActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".porteria.ui.admin.AdminActivity"
            android:exported="false"
            android:label="Panel Administrador" />

        <activity
            android:name=".porteria.ui.bicicletero.BicicleteroDashboardActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"
            android:label="Bitacora Bicicletas" />

        <activity
            android:name=".porteria.ui.db.AdminDirectoryActivity"
            android:exported="false"
            android:label="Gestion de Directorio" />

        <activity
            android:name=".porteria.ui.admin.ShiftReportActivity"
            android:exported="false"
            android:label="Reportes de Turnos" />

        <activity
            android:name=".porteria.ui.db.DatabaseManagerActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"
            android:label="Gestion de Base de Datos" />

        <activity
            android:name=".porteria.ui.settings.SettingsActivity"
            android:exported="false"
            android:label="Ajustes" />

        <activity
            android:name=".porteria.ui.history.HistoryActivity"
            android:exported="false"
            android:label="Historial" />

        <activity
            android:name=".porteria.ui.directory.DirectoryActivity"
            android:exported="false"
            android:label="Directorio" />

        <activity
            android:name=".porteria.ui.examen.ExamenActivity"
            android:exported="false"
            android:label="Examen OS-10" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
